APP_NAME=NEXA ERP API
APP_ENV=development
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexa_erp
POSTGRES_USER=nexa
POSTGRES_PASSWORD=replace-with-a-local-dev-password

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=nexa-erp
JWT_TTL=8h

# Development bootstrap auth for the V11 migration bridge. Replace with persistent auth in a later security migration.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=admin-change-me
BOOTSTRAP_NAME=ERP Administrator
BOOTSTRAP_ROLES=GROUP_ADMIN
BOOTSTRAP_ENTITIES=NDU,NDT
BOOTSTRAP_SITES=JKT-HO,CKR-DC,TGR-WH,SBY-BR,GRK-WH

# For passkeys; browser origin must match EXACTLY. localhost works without HTTPS.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173

# Optional custom face-recognition PILOT. Generated locally by SETUP_FACE_ENGINE.cmd;
# NEVER put FACE_TEMPLATE_KEY in VITE_* variables, Git, screenshots or chat.
FACE_PYTHON=face/.venv/Scripts/python.exe
FACE_MODELS_DIR=face/models
# FACE_TEMPLATE_KEY=<locally generated 32-byte base64 key>
