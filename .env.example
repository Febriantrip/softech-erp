# Docker Compose development defaults
APP_ENV=development

# PostgreSQL 18 baseline. Development follows the latest 18.x image.
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_PGDATA=/var/lib/postgresql/18/docker
POSTGRES_DB=nexa_erp
POSTGRES_USER=nexa
POSTGRES_PASSWORD=replace-with-a-local-dev-password
POSTGRES_PORT_HOST=5432
REDIS_PORT_HOST=6379
API_PORT_HOST=8080
FRONTEND_PORT_HOST=8088
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=admin-change-me
BOOTSTRAP_NAME=ERP Administrator
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088
